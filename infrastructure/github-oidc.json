{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Operator bootstrap: GitHub main branch OIDC, CloudFormation deployment role and fixed Lambda runtime role.",
  "Parameters": {
    "GitHubOidcSubject": {
      "Type": "String",
      "Default": "repo:Varshx183@207301812/aws-auditguard@1413488585:ref:refs/heads/main",
      "Description": "Exact immutable GitHub owner/repository subject, restricted to main.",
      "AllowedPattern": "repo:[A-Za-z0-9_.-]+@[0-9]+/[A-Za-z0-9_.-]+@[0-9]+:ref:refs/heads/main"
    },
    "ExistingProviderArn": {
      "Type": "String",
      "Default": "",
      "Description": "Reuse an existing token.actions.githubusercontent.com IAM provider if present."
    }
  },
  "Conditions": {
    "CreateProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingProviderArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateProvider",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AuditGuardScopedPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/aws-auditguard-detection-detector:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sns:Publish",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:aws-auditguard-AlertsTopic-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:aws-auditguard-detection-processing-failures"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:DescribeSecurityGroupRules",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CloudFormationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AuditGuardScopedPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:CreateFunction",
                    "lambda:DeleteFunction",
                    "lambda:GetFunction",
                    "lambda:GetFunctionConfiguration",
                    "lambda:UpdateFunctionCode",
                    "lambda:UpdateFunctionConfiguration",
                    "lambda:AddPermission",
                    "lambda:RemovePermission",
                    "lambda:GetPolicy",
                    "lambda:TagResource",
                    "lambda:UntagResource",
                    "lambda:ListTags",
                    "lambda:PutFunctionEventInvokeConfig",
                    "lambda:UpdateFunctionEventInvokeConfig",
                    "lambda:GetFunctionEventInvokeConfig",
                    "lambda:DeleteFunctionEventInvokeConfig"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:aws-auditguard-detection-detector"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:aws-auditguard-detection-detector:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:DeleteLogGroup",
                    "logs:PutRetentionPolicy",
                    "logs:DeleteRetentionPolicy",
                    "logs:TagResource",
                    "logs:UntagResource",
                    "logs:ListTagsForResource",
                    "logs:TagLogGroup",
                    "logs:UntagLogGroup",
                    "logs:ListTagsLogGroup"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/aws-auditguard-detection-detector:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/aws-auditguard-detection-detector"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "logs:DescribeLogGroups",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "events:PutRule",
                    "events:DeleteRule",
                    "events:DescribeRule",
                    "events:PutTargets",
                    "events:RemoveTargets",
                    "events:ListTargetsByRule",
                    "events:TagResource",
                    "events:UntagResource",
                    "events:ListTagsForResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/aws-auditguard-detection-ingress"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:CreateQueue",
                    "sqs:DeleteQueue",
                    "sqs:SetQueueAttributes",
                    "sqs:GetQueueAttributes",
                    "sqs:GetQueueUrl",
                    "sqs:TagQueue",
                    "sqs:UntagQueue",
                    "sqs:ListQueueTags"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:aws-auditguard-detection-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricAlarm",
                    "cloudwatch:DeleteAlarms",
                    "cloudwatch:DescribeAlarms",
                    "cloudwatch:TagResource",
                    "cloudwatch:UntagResource",
                    "cloudwatch:ListTagsForResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:aws-auditguard-detection-*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::GetAtt": [
                      "RuntimeRole",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "lambda.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "GitHubDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateProvider",
                    {
                      "Ref": "GitHubProvider"
                    },
                    {
                      "Ref": "ExistingProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Ref": "GitHubOidcSubject"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeployDetectionOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/aws-auditguard-detection/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "cloudformation:RoleArn": {
                        "Fn::GetAtt": [
                          "CloudFormationRole",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:TagResource",
                    "cloudformation:UntagResource",
                    "cloudformation:GetTemplateSummary"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/aws-auditguard-detection/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/aws-auditguard-detection/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/aws-auditguard/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DeleteStack",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/aws-auditguard-detection/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "cloudformation:RoleArn": {
                        "Fn::GetAtt": [
                          "CloudFormationRole",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CloudFormationRole",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "GitHubDeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GitHubDeployRole",
          "Arn"
        ]
      }
    },
    "CloudFormationRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "CloudFormationRole",
          "Arn"
        ]
      }
    },
    "RuntimeRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "RuntimeRole",
          "Arn"
        ]
      }
    },
    "ProviderArn": {
      "Value": {
        "Fn::If": [
          "CreateProvider",
          {
            "Ref": "GitHubProvider"
          },
          {
            "Ref": "ExistingProviderArn"
          }
        ]
      }
    }
  }
}
